# ==========================================
# Backend Environment Variables - REQUIRED
# ==========================================

# Supabase PostgreSQL connection string (from Supabase → Settings → Database → Connection string → URI)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# JWT Secrets - generate strong random strings (e.g. openssl rand -base64 64)
JWT_ACCESS_SECRET="replace-with-strong-random-secret"
JWT_REFRESH_SECRET="replace-with-another-strong-random-secret"

# PORT (leave as 4000 locally, Vercel sets this automatically)
PORT=4000

# Frontend URL (for CORS) - set to your Vercel frontend URL after deploy
FRONTEND_URL="https://fokzanqa.vercel.app"

# ==========================================
# OPTIONAL - Only if you use file uploads
# ==========================================
# S3_ENDPOINT=""
# S3_BUCKET=""
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""
